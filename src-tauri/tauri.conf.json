{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recora",
  "version": "0.1.0",
  "identifier": "com.justaquib.recora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Recora",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 620,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "camera-bubble",
        "title": "Recora Camera",
        "url": "/?widget=camera",
        "width": 240,
        "height": 260,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "recording-controls",
        "title": "Recora Recording Controls",
        "url": "/?widget=controls",
        "width": 468,
        "height": 70,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "recording-setup",
        "title": "Recora Recorder Setup",
        "url": "/?widget=setup",
        "width": 520,
        "height": 720,
        "visible": false,
        "center": true,
        "resizable": false,
        "backgroundThrottling": "disabled",
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "annotation-overlay",
        "title": "Recora Annotations",
        "url": "/?widget=annotations",
        "width": 1440,
        "height": 900,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
